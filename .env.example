# ViralCommerce AI — variables de entorno de referencia.
# Copiar a .env SOLO si una herramienta local lo requiere. Nunca commitear valores reales.
#
# Cloudflare Workers NO lee este archivo:
#   - Variables no secretas → apps/api/wrangler.jsonc ("vars")
#   - Secretos locales     → apps/api/.dev.vars (ver .dev.vars.example)
#   - Secretos en la nube  → `wrangler secret put NOMBRE`

# --- API (apps/api) -------------------------------------------------------
# development | staging | production
# Desarrollo local: npm run dev:api ya pasa APP_ENV=development (--var).
# Lo desplegado es production (fail-closed).
APP_ENV=development
# Orígenes permitidos para CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173
# Interruptor maestro de acciones comerciales reales. Mantener en false.
COMMERCIAL_ACTIONS_ENABLED=false

# --- Dashboard (apps/dashboard) -------------------------------------------
# Vacío = usa el proxy de Vite "/api" → http://localhost:8787
VITE_API_BASE_URL=

# --- Cloudflare (solo para CLI / CI; NO se usan en esta etapa) ------------
# Se obtienen en el panel de Cloudflare. Dejar vacío hasta el primer despliegue.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
